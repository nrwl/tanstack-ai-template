{
  "name": "@tanstack-ai-template/ai",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@tanstack/ai": "0.33.0",
    "zod": "^4.2.0"
  },
  "nx": {
    "sourceRoot": "packages/ai/src",
    "tags": [
      "scope:shared",
      "type:ai"
    ],
    "targets": {
      "typecheck": {
        "executor": "nx:run-commands",
        "options": {
          "command": "tsc --noEmit",
          "cwd": "packages/ai"
        }
      },
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "command": "echo 'lint ok'",
          "cwd": "packages/ai"
        }
      }
    }
  }
}
